<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>topmap_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, configuration and RViz integration for the topmap stack.</description>
  <maintainer email="l888r88f8@gmail.com">topmap</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>topmap_msgs</exec_depend>
  <exec_depend>topmap_ros</exec_depend>
  <!-- run_acceptance.sh invokes the installed write_synthetic_pcd tool directly. -->
  <exec_depend>topmap_surface</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
