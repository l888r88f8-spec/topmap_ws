<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>topmap_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes and message conversions for the topmap stack.</description>
  <maintainer email="l888r88f8@gmail.com">topmap</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>topmap_msgs</depend>
  <depend>topmap_core</depend>
  <depend>topmap_surface</depend>
  <depend>topmap_topology</depend>
  <depend>topmap_planner</depend>
  <depend>pcl_conversions</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
