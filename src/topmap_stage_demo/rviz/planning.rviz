Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Status1
    - /规划结果1
    Splitter Ratio: 0.5
  Tree Height: 640
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: rviz_common/Time
  Experimental: false
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 90; 90; 100
    Enabled: false
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: 网格 (可选, 默认关闭)
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 40
    Reference Frame: <Fixed Frame>
    Value: false
  - Class: rviz_common/Group
    Displays:
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 200; 200; 200
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: 原始点云 · 灰色小点 (alpha 1)
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 1
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /topmap_stage_demo/source_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    Enabled: true
    Name: 原始点云
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 最终 5 区域 (alpha 0.44)
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /topmap_stage_demo/stage3_final_regions
      Value: true
    Enabled: true
    Name: 结构细分(最终5区域)
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 红色通道弦 left-right
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /topmap_stage_demo/stage4_portal_chords
      Value: true
    Enabled: true
    Name: 通道(red chords)
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: START (绿色球)
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /topmap_stage_demo/planning_start
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: GOAL (红色球)
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /topmap_stage_demo/planning_goal
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 最终路径 · 原始 planner.path (橙色粗线)
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /topmap_stage_demo/final_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: 拓扑序列 (绿色, 可选默认关闭)
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /topmap_stage_demo/planned_topology_sequence
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: 地面投影参考线 (render-only 可选, 默认关闭; 不是最终路径)
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /topmap_stage_demo/surface_trace_reference
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 140; 5
      Enabled: false
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: nav_msgs/Path · 原始路径镜像 (可选默认关闭)
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 140; 5
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /topmap_stage_demo/planned_path
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 规划状态 · interactive status (成功/失败/无效点击)
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /topmap_stage_demo/planning_status
      Value: true
    Enabled: true
    Name: 规划结果(原始路径 + START/GOAL)
  Enabled: true
  Global Options:
    Background Color: 24; 26; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /topmap_stage_demo/initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /topmap_stage_demo/goal_pose
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 36
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 15.2
        Y: 3.5
        Z: 0.8
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.5697963
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 4.71238898
    Saved: null
Window Geometry:
  QMainWindow State: 
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1500
  X: 40
  Y: 40
