# TopMap 四阶段叠加演示 RViz 配置 (topmap_stage_demo)
#
# 所有阶段都发布在 map 坐标系、同一 XY 原点；默认全部开启以显示“叠加”效果。
# 若要看某个阶段的干净截面截图，建议在左侧 Displays 面板里临时关闭
# “区域合并(初始3区域)”或“结构细分(最终5区域)”之一，避免两者颜色混在一起。
Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 90; 90; 100
      Enabled: false
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: 网格 (可选, 默认关闭)
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: false
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Class: rviz_default_plugins/PointCloud2
          Color: 200; 200; 200
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: 原始点云 · 灰色小点 (alpha 1)
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 1
          Size (m): 0.02
          Style: Points
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/source_cloud
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
      Enabled: true
      Name: 原始点云
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 三角化 · 表面 (alpha 0.06)
          Namespaces: {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/stage1_triangle_mesh
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 三角化 · 网格边 (细线)
          Namespaces: {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/stage1_triangle_edges
          Value: true
      Enabled: true
      Name: 三角化(表面+网格边)
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 初始 3 个生长区域 (alpha 0.14)
          Namespaces: {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/stage2_grown_regions
          Value: true
      Enabled: true
      Name: 区域合并(初始3区域)
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 最终 5 个区域 (alpha 0.44)
          Namespaces: {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/stage3_final_regions
          Value: true
      Enabled: true
      Name: 结构细分(最终5区域)
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 拓扑连接 R-P-R (绿色, 全部4通道)
          Namespaces: {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/stage4_topology_links
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 区域中心节点 (黄色)
          Namespaces: {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/stage4_region_nodes
          Value: true
      Enabled: true
      Name: 拓扑图(links/nodes)
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 红色通道弦 left-right
          Namespaces: {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/stage4_portal_chords
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: 通道中心节点 (黄色)
          Namespaces: {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/stage4_portal_nodes
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: false
          Name: 实际边界链 (青色, 可选默认关闭)
          Namespaces: {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/stage4_boundary_chains
          Value: false
      Enabled: true
      Name: 通道(red chords/nodes, 可选 actual chain)
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: false
          Name: 区域标签 R# (可选默认关闭)
          Namespaces: {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/region_labels
          Value: false
        - Class: rviz_default_plugins/MarkerArray
          Enabled: false
          Name: 通道标签 P# (可选默认关闭)
          Namespaces: {}
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /topmap_stage_demo/portal_labels
          Value: false
      Enabled: false
      Name: 标签(可选, 默认关闭)
  Enabled: true
  Global Options:
    Background Color: 24; 26; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 36
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 15.2
        Y: 3.5
        Z: 0.8
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 4.71238898
    Saved: ~
Window Geometry:
  QMainWindow State: 
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1500
  X: 40
  Y: 40
